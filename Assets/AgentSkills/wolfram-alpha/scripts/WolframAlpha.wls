#!/usr/bin/env wolframscript

(* Generated by BuildAgentSkills.wls - do not edit manually *)

(* :!CodeAnalysis::BeginBlock:: *)
(* :!CodeAnalysis::Disable::SuspiciousSessionSymbol:: *)

(* ::Section:: *)
(*Argument Parsing*)

(* Usage and help text *)
$usage = "wolframscript -f WolframAlpha.wls <query>";

$helpText = StringJoin[
    "Usage: ", $usage, "\n\n",
    "Use natural language queries with Wolfram|Alpha to get up-to-date computational results about entities in chemistry, physics, geography, history, art, astronomy, and more.\nAlways use the Wolfram context tool before using this tool to make sure you have the most up-to-date information.\n\n",
    "Arguments:\n",
    "  query (required): The query to send to Wolfram|Alpha.\n"
];

(* Check for --usage flag *)
If[ MemberQ[ $ScriptCommandLine, "--usage" ],
    WriteString[ "stdout", $helpText ];
    Exit[ 0 ]
];

(* Parse command-line arguments *)
Module[ { rawArgs, positional, flags, i, key, value },

    rawArgs = Drop[ $ScriptCommandLine, 1 ];
    positional = { };
    flags = <| |>;
    i = 1;

    While[ i <= Length @ rawArgs,
        If[ StringStartsQ[ rawArgs[[ i ]], "--" ],
            key = StringDrop[ rawArgs[[ i ]], 2 ];
            If[ i + 1 <= Length @ rawArgs,
                value = rawArgs[[ i + 1 ]];
                flags[ key ] = value;
                i += 2,
                (* --flag with no value *)
                WriteString[ "stderr", "[Error] Flag --" <> key <> " requires a value.\n" ];
                Exit[ 1 ]
            ],
            AppendTo[ positional, rawArgs[[ i ]] ];
            i += 1
        ]
    ];

    $parsedArgs = <| |>;
    (* Validate required arguments *)
    If[ Length @ positional < 1,
        WriteString[ "stderr", "[Error] Missing required argument(s).\n\n" <> $helpText ];
        Exit[ 1 ]
    ];

    $parsedArgs[ "query" ] = positional[[ 1 ]];
];

(* ::Section:: *)
(*Tool Invocation*)

(* Keep stdout clean for the tool result (progress output is written to stdout in scripts) *)
$ProgressReporting = False;

Quiet[
    PacletInstall[ "Wolfram/AgentTools" ],
    PacletInstall::samevers
];
Get[ "Wolfram`AgentTools`" ];

tool = $DefaultMCPTools[ "WolframAlpha" ];

If[ ! MatchQ[ tool, _LLMTool ],
    WriteString[ "stderr", "[Error] Failed to load tool: WolframAlpha\n" ];
    Exit[ 1 ]
];

result = Quiet[
    tool[ $parsedArgs ],
    { General::messages }
];


(* Post-process result *)
postProcessResult[ result_String ] := result;
postProcessResult[ KeyValuePattern[ "String" -> result_String ] ] := result;
postProcessResult[ KeyValuePattern[ "Content" -> result_ ] ] := postProcessResult @ result;
postProcessResult[ content: { KeyValuePattern[ "type" -> _String ]... } ] := StringJoin @ Flatten[ postProcessResult /@ content ];
postProcessResult[ KeyValuePattern @ { "type" -> "text", "text" -> result_String } ] := result;
postProcessResult[ KeyValuePattern[ "type" -> "image" ] ] := "<image>";

postProcessResult[ failure_Failure ] := (
    WriteString[ "stderr", "[Error] " <> ToString @ failure[ "Message" ] ];
    Exit[ 1 ];
);

postProcessResult[ other___ ] := (
    WriteString[ "stderr", "[Error] Unexpected result: " <> ToString @ HoldCompleteForm @ other ];
    Exit[ 1 ];
);

result = postProcessResult @ result;

If[ ! TrueQ @ StringQ @ result,
    WriteString[ "stderr", "[Error] Unexpected result: " <> ToString @ result ];
    Exit[ 1 ];
];

(* Characters in the Unicode private use area (e.g. \[Rule]) only display correctly in notebooks, so they're converted
   like the MCP server does. This is defined here since the installed paclet version might not include the function. *)
convertPUACharacters[ str_String ] := StringReplace[
    str,
    c: RegularExpression[ "[\\x{E000}-\\x{F8FF}]" ] :> ToString[ c, CharacterEncoding -> "PrintableASCII" ]
];

WriteString[ "stdout", convertPUACharacters @ result ];
Exit[ 0 ];

(* :!CodeAnalysis::EndBlock:: *)